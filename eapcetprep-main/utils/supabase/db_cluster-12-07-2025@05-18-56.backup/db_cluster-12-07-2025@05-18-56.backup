line" style="vertical-align: -0.5em;"><mn>2</mn></span></msub><msub><mi class="ma-repel-adj" mathvariant="normal">CO</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>3</mn></span></msub></mrow></mrow></mrow></fmath><br/>1 mole of <fmath class="fm-inline"><msub><mi class="ma-repel-adj" mathvariant="normal">CaCO</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>3</mn></span></msub></fmath> reacts with 2 moles of <fmath class="fm-inline"><mi class="ma-repel-adj" mathvariant="normal">HCl</mi></fmath><br/><fmath class="fm-inline"><mrow><mn>100</mn><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">g</mi></mrow></fmath> of <fmath class="fm-inline"><mrow><msub><mi class="ma-repel-adj" mathvariant="normal">CaCO</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>3</mn></span></msub><mo class="fm-infix-loose">=</mo><mn>1</mn></mrow></fmath> mole of <fmath class="fm-inline"><msub><mi class="ma-repel-adj" mathvariant="normal">CaCO</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>3</mn></span></msub></fmath><br/><fmath class="fm-inline"><mrow><mn>200</mn><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">g</mi></mrow></fmath> of <fmath class="fm-inline"><mrow><msub><mi class="ma-repel-adj" mathvariant="normal">CaCO</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>3</mn></span></msub><mo class="fm-infix-loose">=</mo><mn>2</mn></mrow></fmath> moles of <fmath class="fm-inline"><msub><mi class="ma-repel-adj" mathvariant="normal">CaCO</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>3</mn></span></msub></fmath><br/>2 moles of <fmath class="fm-inline"><msub><mi class="ma-repel-adj" mathvariant="normal">CaCO</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>3</mn></span></msub></fmath> will react with 4 moles of <fmath class="fm-inline"><mi class="ma-repel-adj" mathvariant="normal">HCl</mi></fmath><br/>1 mole of <fmath class="fm-inline"><mrow><mi class="ma-repel-adj" mathvariant="normal">HCl</mi><mo class="fm-infix-loose">=</mo><mrow><mn>36.5</mn><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">g</mi></mrow></mrow></fmath> of <fmath class="fm-inline"><mi class="ma-repel-adj" mathvariant="normal">HCl</mi></fmath><br/>4 moles of <fmath class="fm-inline"><mrow><mi class="ma-repel-adj" mathvariant="normal">HCl</mi><mo class="fm-infix-loose">=</mo><mrow><mn>4</mn><mo class="fm-infix" lspace=".22em" rspace=".22em">×</mo><mrow><mn>36.5</mn><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">g</mi></mrow></mrow></mrow></fmath> of <fmath class="fm-inline"><mrow><mi class="ma-repel-adj" mathvariant="normal">HCl</mi><mo class="fm-infix-loose">=</mo><mrow><mn>146</mn><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">g</mi></mrow></mrow></fmath> of <fmath class="fm-inline"><mi class="ma-repel-adj" mathvariant="normal">HCl</mi></fmath><br/><fmath class="fm-inline"><mrow><mn>50</mn><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">g</mi></mrow></fmath> of <fmath class="fm-inline"><mi class="ma-repel-adj" mathvariant="normal">HCl</mi></fmath> is present in <fmath class="fm-inline"><mrow><mn>100</mn><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">g</mi></mrow></fmath> solution.<br/><fmath class="fm-inline"><mrow><mn>146</mn><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">g</mi></mrow></fmath> of <fmath class="fm-inline"><mi class="ma-repel-adj" mathvariant="normal">HCl</mi></fmath> will be present in <fmath class="fm-inline"><mrow><mn>292</mn><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">g</mi></mrow></fmath> solution. </div>
