er-top-width: 0.072em;"><mn>400</mn></span></span></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mrow><mn>20</mn><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">m</mi></mrow><mo class="fm-infix-loose">∕</mo><mrow><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;"> </mi><mi class="fm-mi-length-1" mathvariant="italic">s</mi></mrow></mrow></mrow></fmath><br/>Given, rate of flow <fmath class="fm-inline"><mo>=</mo></fmath> area <fmath class="fm-inline"><mo lspace=".22em" rspace=".22em">×</mo></fmath> velocity<br/> <fmath class="fm-inline"><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic">A</mi><mi class="fm-mi-length-1" mathvariant="italic">v</mi></mrow><mo class="fm-infix-loose">=</mo><mrow><mrow><mn>3.08</mn><mo class="fm-infix" lspace=".22em" rspace=".22em">×</mo><mrow><msup><mn>10</mn><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mrow><mo class="fm-prefix-tight">−</mo><mn>5</mn></mrow></span></msup><msup><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">m</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>3</mn></span></msup></mrow></mrow><mo class="fm-infix-loose">∕</mo><mrow><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;"> </mi><mi class="fm-mi-length-1" mathvariant="italic">s</mi></mrow></mrow></mrow></fmath> <br/> <fmath class="fm-inline"><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mi class="fm-mi-length-1" mathvariant="italic">A</mi></mrow><mo class="fm-infix-loose">=</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow><span mtagname="mfrac" style="vertical-align: 0.126em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mn>3.08</mn><mo class="fm-infix" lspace=".22em" rspace=".22em">×</mo><msup><mn>10</mn><span class="fm-script fm-inline" style