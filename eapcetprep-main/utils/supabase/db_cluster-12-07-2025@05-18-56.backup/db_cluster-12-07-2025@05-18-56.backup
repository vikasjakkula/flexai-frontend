</mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><msup><mrow><mo class="fm-mo-Luc">(</mo><mrow><mn>4</mn><mo class="fm-infix">−</mo><mn>1</mn></mrow><mo class="fm-mo-Luc">)</mo></mrow><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup></mrow><mo class="fm-infix">+</mo><msup><mrow><mo class="fm-mo-Luc">(</mo><mrow><mn>0</mn><mo class="fm-infix">+</mo><mn>1</mn></mrow><mo class="fm-mo-Luc">)</mo></mrow><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup></mrow><mo class="fm-infix">+</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">λ</mi><mrow><mo class="fm-mo-Luc">(</mo><mrow><mrow><mn>12</mn><mo class="fm-infix">−</mo><mn>0</mn></mrow><mo class="fm-infix">−</mo><mn>7</mn></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow><mo class="fm-infix-loose">=</mo><mn>0</mn></mrow></fmath><br/><fmath class="fm-inline"><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mo class="fm-infix-loose">⇒</mo><mrow><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mn>9</mn></mrow><mo class="fm-infix">+</mo><mn>1</mn></mrow><mo class="fm-infix">+</mo><mrow><mn>5</mn><mi class="fm-mi-length-1" mathvariant="italic">λ</mi></mrow></mrow></mrow><mo class="fm-infix-loose">=</mo><mn>0</mn></mrow></fmath><br/><fmath class="fm-inline"><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mo class="fm-infix-loose">⇒</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mi class="f