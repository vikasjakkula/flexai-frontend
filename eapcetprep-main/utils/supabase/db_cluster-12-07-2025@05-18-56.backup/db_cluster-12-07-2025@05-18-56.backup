o class="fm-infix">+</mo><msup><mi class="fm-mi-length-1" mathvariant="italic">y</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup></mrow><mo class="fm-infix">+</mo><mrow><mn>6</mn><mi class="fm-mi-length-1" mathvariant="italic">x</mi></mrow></mrow><mo class="fm-infix">−</mo><mrow><mn>8</mn><mi class="fm-mi-length-1" mathvariant="italic">y</mi></mrow></mrow><mo class="fm-infix">+</mo><mn>9</mn></mrow><mo class="fm-infix-loose">=</mo><mn>0</mn></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><msup><mrow><mo class="fm-mo-Luc">(</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">x</mi><mo class="fm-infix">+</mo><mn>3</mn></mrow><mo class="fm-mo-Luc">)</mo></mrow><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup><mo class="fm-infix">+</mo><msup><mrow><mo class="fm-mo-Luc">(</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">y</mi><mo class="fm-infix">−</mo><mn>4</mn></mrow><mo class="fm-mo-Luc">)</mo></mrow><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup></mrow></mrow><mo class="fm-infix-loose">=</mo><msup><mn>4</mn><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup></mrow></fmath><br/>Centre <fmath class="fm-inline"><mrow><mrow><msub><mi class="fm-mi-length-1" mathvariant="italic">O</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>2</mn></span></msub><mo class="fm-infix-loose">:</mo><mrow><mo class="fm-mo-Luc">(</mo><mrow><mrow><mo class="fm-prefix-tight">−</mo><mn>3</mn></mrow><mo class="fm-separator">,</mo><mn>4</mn></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow><mo class="fm-separator">;</mo><mrow><mrow><msub><mi class="fm-mi-length-1" mathvariant="italic">r</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>2</mn></span></msub><mo class="fm-infix-loose">=</mo><mrow mtagname="msqrt"><mo class="fm-radic">√</mo><span style="vertical-align: 0.086em;"><span class="fm-vert fm-radicand" style="border-top-width: 0.072em;"><mrow><mrow><mn>9</mn><mo class="fm-infix">+</mo><mn>16</mn></mrow><mo class="fm-infix">−</mo><mn>9</mn></mrow></span></span></mrow></mrow><mo class="fm-infix-loose">=</mo><mn>4</mn></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><msub><mi class="fm-mi-length-1" mathvariant="italic">r</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>1</mn></span></msub><mo class="fm-infix">+</mo><msub><mi class="fm-mi-length-1" mathvariant="italic">r</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>2</mn></span></msub></mrow><mo class="fm-infix-loose">=</mo><mn>9</mn></mrow></fmath><br/>and<br/> <fmath class="fm-inline"><mrow><mo class="fm-mo-Luc" style="font-size: 2.05em; vertical-align: -0.128em; display: inline-block; transform: scaleX(0.5);">|</mo><mrow><mrow><msub><mi class="fm-mi-length-1" mathvariant="italic">r</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>1</mn></span></msub><mo class="fm-infix">−</mo><mrow><msub><mi class="fm-mi-length-1" mathvariant="italic">r</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>2</mn></span></msub><mrow><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mspace style="margin-right: 0px; padding-right: 0.001em; visibility: hidden;">‌</mspace></td></tr><tr><td class="fm-den-frac fm-inline"><mspace style="margin-right: 0px; padding-right: 0.001em; visibility: hidden;">‌</mspace></td></tr></tbody></table></span></span><mo class="fm-mo-Luc" style="font-size: 2.05em; vertical-align: -0.128em; display: inline-block; transform: scaleX(0.5);">|</mo></mrow></mrow></mrow><mo class="fm-infix-loose">=</mo><mn>1</mn></mrow></mrow></fmath><br/>Two tangents are there, so <fmath class="fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic">n</mi><mo class="fm-infix-loose">=</mo><mn>2</mn></mrow></fmath><br/><div class="hscrollenable"><img src="static/media/wl_client/1/qdump/dd962b43da3e663bef2c213d7dbe3f88/4728ca39b8950491b2159556bc92b1a2.png"/></div><br/> <fmath class="fm-inline"><mi class="fm-mi-length-1" mathvariant="italic">P</mi></fmath> divides <fmath class="fm-inline"><msub><mi class="fm-mi-length-1" mathvariant="italic">O</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>1</mn></span></msub></fmath> and <fmath class="fm-inline"><msub><mi class="fm-mi-length-1" mathvariant="italic">O</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>2</mn></span></msub></fmath> in <fmath class="fm-inline"><mrow><mn>5</mn><mo class="fm-infix-loose">:</mo><mn>4</mn></mrow></fmath> ratio externally<br/> <fmath class="fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic">P</mi><mrow><mo class="fm-mo-Luc" style="font-size: 2.05em; vertical-align: -0.128em; display: inline-block; transform: scaleX(0.5);">(</mo><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mrow><mo class="fm-mo-Luc">(</mo><mrow><mo class="fm-prefix-tight">−</mo><mrow><mn>3</mn><mo class="fm-infix" lspace=".22em" rspace=".22em">×</mo><mn>5</mn></mrow></mrow><mo class="fm-mo-Luc">)</mo></mrow><mo class="fm-infix">−</mo><mrow><mo class="fm-mo-Luc">(</mo><mrow><mo class="fm-prefix-tight">−</mo><mrow><mn>1</mn><mo class="fm-infix" lspace=".22em" rspace=".22em">×</mo><mn>4</mn></mrow></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><mrow><mn>5</mn><mo class="fm-infix">−</mo><mn>4</mn></mrow></td></tr></tbody></table></span></span></mrow><mo class="fm-separator">,</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mrow><mo class="fm-mo-Luc">(</mo><mrow><mn>4</mn><mo class="fm-infix" lspace=".22em" rspace=".22em">×</mo><mn>5</mn></mrow><mo class="fm-mo-Luc">)</mo></mrow><mo class="fm-infix">−</mo><mrow><mo class="fm-mo-Luc">(</mo><mrow><mrow><mn>4</mn><mo class="fm-postfix-tight" lspace=".22em" rspace=".22em">×</mo></mrow><mo class="fm-infix">−</mo><mn>2</mn></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><mrow><mn>5</mn><mo class="fm-infix">−</mo><mn>4</mn></mrow></td></tr></tbody></table></span></span></mrow></mrow><mo class="fm-mo-Luc" style="font-size: 2.05em; vertical-align: -0.128em; display: inline-block; transform: scaleX(0.5);">)</mo></mrow></mrow></fmath> <br/> <fmath class="fm-inline"><mrow><mo class="fm-prefix-tight">≡</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">P</mi><mrow><mo class="fm-mo-Luc">(</mo><mrow><mrow><mo class="fm-prefix-tight">−</mo><mn>11</mn></mrow><mo class="fm-separator">,</mo><mn>28</mn></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mi class="fm-mi-length-1" mathvariant="italic">L</mi></fmath> is the length of tangent from <fmath class="fm-inline"><mi class="fm-mi-length-1" mathvariant="italic">P</mi></fmath> to <fmath class="fm-inline"><msub><mi class="fm-mi-length-1" mathvariant="italic">C</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>2</mn></span></msub></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">l</mi><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mo class="fm-infix-loose">=</mo><mrow mtagname="msqrt"><mo class="fm-radic" style="font-size: 1.366em; vertical-align: -0.069em; display: inline-block; transform: scaleX(0.5);">√</mo><span style="vertical-align: 0.22em;"><span class="fm-vert fm-radicand" style="border-top-width: 0.087em;"><mrow><mrow><msup><mrow><mo class="fm-mo-Luc">(</mo><mrow><mrow><mo class="fm-prefix-tight">−</mo><mn>11</mn></mrow><mo class="fm-infix">+</mo><mn>3</mn></mrow><mo class="fm-mo-Luc">)</mo></mrow><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup><mo class="fm-infix">+</mo><msup><mrow><mo class="fm-mo-Luc">(</mo><mrow><mn>28</mn><mo class="fm-infix">−</mo><mn>4</mn></mrow><mo class="fm-mo-Luc">)</mo></mrow><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup></mrow><mo class="fm-infix">−</mo><msup><mn>4</mn><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup></mrow></span></span></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mo class="fm-infix-loose">=</mo><mrow mtagname="msqrt"><mo class="fm-radic">√</mo><span style="vertical-align: 0.086em;"><span class="fm-vert fm-radicand" style="border-top-width: 0.072em;"><mrow><mrow><mn>64</mn><mo class="fm-infix">+</mo><mn>576</mn></mrow><mo class="fm-infix">−</mo><mn>16</mn></mrow></span></span></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mo class="fm-infix-loose">=</mo><mrow mtagname="msqrt"><mo class="fm-radic">√</mo><span style="vertical-align: 0.086em;"><span class="fm-vert fm-radicand" style="border-top-width: 0.072em;"><mn>624</mn></span></span></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mn>4</mn><mrow mtagname="msqrt"><mo class="fm-radic">√</mo><span style="vertical-align: 0.086em;"><span class="fm-vert fm-radicand" style="border-top-width: 0.072em;"><mn>39</mn></span></span></mrow></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: -0.126em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">l</mi></td></tr><tr><td class="fm-den-frac fm-inline"><msup><mi class="fm-mi-length-1" mathvariant="italic">n</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup></td></tr></tbody></table></span></span></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mo class="fm-infix-loose">=</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0.086em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mn>4</mn><mrow mtagname="msqrt"><mo class="fm-radic">√</mo><span style="vertical-align: 0.086em;"><span class="fm-vert fm-radicand" style="border-top-width: 0.072em;"><mn>39</mn></span></span></mrow></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><mn>4</mn></td></tr></tbody></table></span></span></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow mtagname="msqrt"><mo class="fm-radic">√</mo><span style="vertical-align: 0.086em;"><span class="fm-vert fm-radicand" style="border-top-width: 0.072em;"><mn>39</mn></span></span></mrow></mrow></fmath></div>
