em;"><span class="fm-vert"><table><tbody><tr><td><mo style="display: block; margin-top: 0em; margin-bottom: -0.5em;">^</mo></td></tr><tr><td class="fm-underover-base"><mi class="fm-mi-length-1" mathvariant="italic">k</mi></td></tr></tbody></table></span></span><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mtext> and </mtext></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mi class="fm-mi-length-1" mathvariant="italic">c</mi></mrow><mo class="fm-infix-loose">=</mo><mrow><mn>2</mn><mrow><span mtagname="mover" style="vertical-align: 0.35em;"><span class="fm-vert"><table><tbody><tr><td><mo style="display: block; margin-top: 0em; margin-bottom: -0.5em;">^</mo></td></tr><tr><td class="fm-underover-base"><mi class="fm-mi-length-1" mathvariant="italic">i</mi></td></tr></tbody></table></span></span><mo class="fm-infix">−</mo><mrow><span mtagname="mover" style="vertical-align: 0.35em;"><span class="fm-vert"><table><tbody><tr><td><mo style="display: block; margin-top: 0em; margin-bottom: -0.5em;">^</mo></td></tr><tr><td class="fm-underover-base"><mi class="fm-mi-length-1" mathvariant="italic">j</mi></td></tr></tbody></table></span></span><mo class="fm-infix">+</mo><span mtagname="mover" style="vertical-align: 0.35em;"><span class="fm-vert"><table><tbody><tr><td><mo style="display: block; margin-top: 0em; margin-bottom: -0.5em;">^</mo></td></tr><tr><td class="fm-underover-base"><mi class="fm-mi-length-1" mathvariant="italic">k</mi></td></tr></tbody></table></span></span></mrow></mrow></mrow></mrow></mrow></mrow></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic">a</mi><mo class="fm-infix">⋅</mo><mrow><mo class="fm-mo-Luc">(</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">b</mi><mo class="fm-infix" lspace=".22em" rspace=".22em">×</mo><mi class="fm-mi-length-1" mathvariant="italic">c</mi></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow><mo class="fm-infix-loose">=</mo><mn>0</mn></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mo class="fm-mo-Luc" style="font-size: 4.25em; vertical-align: -0.191em; display: inline-block; transform: scaleX(0.5);">|</mo><span class="fm-vert" mtagname="mtable"><table><tbody><tr class="fm-mtr" mtagname="mtr"><td class="fm-mtd" mtagname="mtd"><mi class="fm-mi-length-1" mathvariant="italic">a</mi></td><td class="fm-mtd" mtagname="mtd"><mi class="fm-mi-length-1" mathvariant="italic">b</mi></td><td class="fm-mtd" mtagname="mtd"><mi class="fm-mi-length-1" mathvariant="italic">c</mi></td></tr><tr class="fm-mtr" mtagname="mtr"><td class="fm-mtd" mtagname="mtd"><mn>1</mn></td><td class="fm-mtd" mtagname="mtd"><mn>2</mn></td><td class="fm-mtd" mtagname="mtd"><mn>1</mn></td></tr><tr class="fm-mtr" mtagname="mtr"><td class="fm-mtd" mtagname="mtd"><mn>2</mn></td><td class="fm-mtd" mtagname="mtd"><mrow><mo class="fm-prefix-tight">−</mo><mn>1</mn></mrow></td><td class="fm-mtd" mtagname="mtd"><mn>1</mn></td></tr></tbody></table></span><mo class="fm-mo-Luc" style="font-size: 4.25em; vertical-align: -0.191em; display: inline-block; transform: scaleX(0.5);">|</mo></mrow><mo class="fm-infix-loose">=</mo><mn>0</mn></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow><mn>3</mn><mi class="fm-mi-length-1" mathvariant="italic">a</mi></mrow></mrow><mo class="fm-infix">+</mo><mi class="fm-mi-length-1" mathvariant="italic">b</mi></mrow><mo class="fm-infix">−</mo><mrow><mn>5</mn><mi class="fm-mi-length-1" mathvariant="italic">c</mi></mrow></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mn>0</mn><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-infix">⋅</mo><mrow><mo class="fm-mo-Luc">(</mo><mi class="fm-mi-length-1" mathvariant="italic">i</mi><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic">a</mi><mi class="fm-mi-length-1" mathvariant="italic">⟂</mi></mrow><mrow><mo class="fm-mo-Luc">(</mo><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic">i</mi><mo class="fm-infix">+</mo><mi class="fm-mi-length-1" mathvariant="italic">j</mi></mrow><mo class="fm-infix">+</mo><mrow><mn>3</mn><mi class="fm-mi-length-1" mathvariant="italic">k</mi></mrow></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow><mo class="fm-infix-loose">⇒</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">a</mi><mo class="fm-infix">⋅</mo><mrow><mo class="fm-mo-Luc">(</mo><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic">i</mi><mo class="fm-infix">+</mo><mi class="fm-mi-length-1" mathvariant="italic">j</mi></mrow><mo class="fm-infix">+</mo><mrow><mn>3</mn><mi class="fm-mi-length-1" mathvariant="italic">k</mi></mrow></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow><mo class="fm-infix-loose">=</mo><mn>0</mn></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic">a</mi><mo class="fm-infix">+</mo><mi class="fm-mi-length-1" mathvariant="italic">b</mi></mrow><mo class="fm-infix">+</mo><mrow><mn>3</mn><mi class="fm-mi-length-1" mathvariant="italic">c</mi></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mn>0</mn><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-infix">⋅</mo><mrow><mo class="fm-mo-Luc">(</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">i</mi><mi class="fm-mi-length-1" mathvariant="italic">i</mi></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow></fmath><br/>Projection of <fmath class="fm-inline"><mi class="fm-mi-length-1" mathvariant="italic">a</mi></fmath> on <fmath class="fm-inline"><mi class="fm-mi-length-1" mathvariant="italic">b</mi></fmath> is <fmath class="fm-inline"><mrow><mn>3</mn><mrow mtagname="msqrt"><mo class="fm-radic">√</mo><span style="vertical-align: 0.086em;"><span class="fm-vert fm-radicand" style="border-top-width: 0.072em;"><mn>6</mn></span></span></mrow></mrow></fmath> .<br/> <fmath class="fm-inline"><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic">a</mi><mo class="fm-infix">⋅</mo><mi class="fm-mi-length-1" mathvariant="italic">b</mi></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><mrow><mo class="fm-mo-Luc">|</mo><mi class="fm-mi-length-1" mathvariant="italic">b</mi><mo class="fm-mo-Luc">|</mo></mrow></td></tr></tbody></table></span></span></mrow><mo class="fm-infix-loose">=</mo><mrow><mn>3</mn><mrow mtagname="msqrt"><mo class="fm-radic">√</mo><span style="vertical-align: 0.086em;"><span class="fm-vert fm-radicand" style="border-top-width: 0.072em;"><mn>6</mn></span></span></mrow></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: -0.086em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic">a</mi><mo class="fm-infix">+</mo><mrow><mn>2</mn><mi class="fm-mi-length-1" mathvariant="italic">b</mi></mrow></mrow><mo class="fm-infix">+</mo><mi class="fm-mi-length-1" mathvariant="italic">c</mi></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><mrow mtagname="msqrt"><mo class="fm-radic">√</mo><span style="vertical-align: 0.086em;"><span class="fm-vert fm-radicand" style="border-top-width: 0.072em;"><mrow><mrow><mn>1</mn><mo class="fm-infix">+</mo><mn>4</mn></mrow><mo class="fm-infix">+</mo><mn>1</mn></mrow></span></span></mrow></td></tr></tbody></table></span></span></mrow><mo class="fm-infix-loose">=</mo><mrow><mn>3</mn><mrow mtagname="msqrt"><mo class="fm-radic">√</mo><span style="vertical-align: 0.086em;"><span class="fm-vert fm-radicand" style="border-top-width: 0.072em;"><mn>6</mn></span></span></mrow></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mi class="fm-mi-length-1" mathvariant="italic">a</mi></mrow><mo class="fm-infix">+</mo><mrow><mn>2</mn><mi class="fm-mi-length-1" mathvariant="italic">b</mi></mrow></mrow><mo class="fm-infix">+</mo><mi class="fm-mi-length-1" mathvariant="italic">c</mi></mrow><mo class="fm-infix-loose">=</mo><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mn>18</mn><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-infix">⋅</mo><mrow><mo class="fm-mo-Luc">(</mo><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic">i</mi><mi class="fm-mi-length-1" mathvariant="italic">i</mi></mrow><mi class="fm-mi-length-1" mathvariant="italic">i</mi></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow></fmath><br/>On subtracting Eq. (ii) from Eq. (i),<br/>. <fmath class="fm-inline"><mrow><mrow><mrow><mrow><mn>2</mn><mi class="fm-mi-length-1" mathvariant="italic">a</mi></mrow><mo class="fm-infix">−</mo><mrow><mn>8</mn><mi class="fm-mi-length-1" mathvariant="italic">c</mi></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mn>0</mn><mo class="fm-infix-loose">⇒</mo><mi class="fm-mi-length-1" mathvariant="italic">a</mi></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mn>4</mn><mi class="fm-mi-length-1" mathvariant="italic">c</mi></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-infix">⋅</mo><mrow><mo class="fm-mo-Luc">(</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">i</mi><mi class="fm-mi-length-1" mathvariant="italic">v</mi></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow></fmath><br/>On multiplying 2 in Eq. (ii) and subtracting<br/>Eq. (iii), we get<br/> <fmath class="fm-inline"><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic">a</mi><mo class="fm-infix">+</mo><mrow><mn>5</mn><mi class="fm-mi-length-1" mathvariant="italic">c</mi></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mo class="fm-prefix-tight">−</mo><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mn>18</mn><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-infix">⋅</mo><mrow><mo class="fm-mo-Luc">(</mo><mi class="fm-mi-length-1" mathvariant="italic">v</mi><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow></mrow></fmath><br/>From Eqs. (iv) and (v), <fmath class="fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic">c</mi><mo cl