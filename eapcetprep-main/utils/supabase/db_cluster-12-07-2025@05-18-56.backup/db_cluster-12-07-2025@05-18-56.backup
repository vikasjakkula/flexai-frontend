c fm-inline"><mn>165</mn></td></tr><tr><td class="fm-den-frac fm-inline"><mn>4</mn></td></tr></tbody></table></span></span></mrow></mrow></mrow></fmath><br/><fmath class="fm-inline"><mrow><mrow><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic">α</mi><mi class="fm-mi-length-1" mathvariant="italic">β</mi></mrow><mo class="fm-infix">+</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">β</mi><mi class="fm-mi-length-1" mathvariant="italic">γ</mi></mrow></mrow><mo class="fm-infix">+</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">γ</mi><mi class="fm-mi-length-1" mathvariant="italic">α</mi></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mo class="fm-prefix-tight">−</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mn>7</mn></td></tr><tr><td class="fm-den-frac fm-inline"><mn>4</mn></td></tr></tbody></table></span></span></mrow></mrow></mrow></fmath><br/>Now, <fmath class="fm-inline"><mrow><mrow><mrow><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic">a</mi><msup><mi class="fm-mi-length-1" mathvariant="italic">x</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>3</mn></span></msup></mrow><mo class="fm-infix">+</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">b</mi><msup><mi class="fm-mi-length-1" mathvariant="italic">x</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup></mrow></mrow><mo class="fm-infix">+</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">c</mi><mi class="fm-mi-length-1" mathvariant="italic">x</mi></mrow></mrow><mo class="fm-infix">+</mo><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">d</mi></mrow><mo class="fm-infix-loose">=</mo><mn>0</mn></mrow></fmath> has roots <fmath class="fm-inline"><mrow><mrow><mi clas