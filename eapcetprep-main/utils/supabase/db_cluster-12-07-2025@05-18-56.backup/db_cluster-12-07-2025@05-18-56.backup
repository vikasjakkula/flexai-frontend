}fmath menclose[notation=box],menclose.fm-menclose[notation=box]{border:thin solid}fmath none{display:none}</style><div class="text-primary border-bottom p-2 mb-2 d-flex justify-content-between align-items-center"> </div><div style="position: relative;z-index:1"> Given, <fmath class="fm-inline"><mrow><mrow><msub><mi class="fm-mi-length-1" mathvariant="italic">C</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>1</mn></span></msub><mo class="fm-infix-loose">:</mo><mrow><msup><mi class="fm-mi-length-1" mathvariant="italic">y</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup><mo class="fm-infix-loose">=</mo><mrow><mrow><mn>4</mn><mi class="fm-mi-length-1" mathvariant="italic">a</mi></mrow><mi class="fm-mi-length-1" mathvariant="italic">x</mi></mrow></mrow></mrow><mo class="fm-separator">,</mo><mrow><msub><mi class="fm-mi-length-1" mathvariant="italic">C</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>2</mn></span></msub><mo class="fm-infix-loose">:</mo><mrow><mrow><msup><mi class="fm-mi-length-1" mathvariant="italic">x</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup><mo class="fm-infix">+</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0.126em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><msup><mi class="fm-mi-length-1" mathvariant="italic">y</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup></td></tr><tr><td class="fm-den-frac fm-inline"><mn>2</mn></td></tr></tbody></table></span></span></mrow></mrow><mo class="fm-infix-loose">=</mo><msup><mi class="fm-mi-length-1" mathvariant="italic">c</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup></mrow></mrow></mrow></fmath><br/>Let point of intersection of two curves is <fmath class="fm-inline"><mrow><mo class="fm-mo-Luc">(</mo><mrow><msub><mi class="fm-mi-length-1" mathvariant="italic">x</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>1</mn></span></msub><mo class="fm-separator">,</mo><msub><mi class="fm-mi-length-1" mathvariant="italic">y</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>1</mn></span></msub></mrow><mo class="fm-mo-Luc">)</mo></mrow></fmath>.<br/><fmath class="fm-inline"><mrow><msub><mi class="fm-mi-length-1" mathvariant="italic">C</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>1</mn></span></msub><mo class="fm-infix-loose">:</mo><mrow><msup><mi class="fm-mi-length-1" mathvariant="italic">y</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup><mo class="fm-infix-loose">=</mo><mrow><mrow><mn>4</mn><mi class="fm-mi-length-1" mathvariant="italic">a</mi></mrow><mi class="fm-mi-length-1" mathvariant="italic">x</mi></mrow></mrow></mrow></fmath><br/><fmath class="fm-inline"><mrow><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><mrow><mn>2</mn><mi class="fm-mi-length-1" mathvariant="italic">y</mi></mrow><msub><mrow><mo class="fm-mo-Luc" style="font-size: 2.05em; vertical-align: -0.128em; display: inline-block; transform: scaleX(0.5);">(</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">d</mi><mi class="fm-mi-length-1" mathvariant="italic">y</mi></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">d</mi><mi class="fm-mi-length-1" mathvariant="italic">x</mi></mrow></td></tr></tbody></table></span></span></mrow><mo class="fm-mo-Luc" style="font-size: 2.05em; vertical-align: -0.128em; display: inline-block; transform: scaleX(0.5);">)</mo></mrow><span class="fm-script fm-inline" style="vertical-align: -1.03em;"><mn>1</mn></span></msub></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mrow><mn>4</mn><mi class="fm-mi-length-1" mathvariant="italic">a</mi></mrow><mo class="fm-infix-loose">⇒</mo><msub><mrow><mo class="fm-mo-Luc" style="font-size: 2.05em; vertical-align: -0.128em; display: inline-block; transform: scaleX(0.5);">(</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">d</mi><mi class="fm-mi-length-1" mathvariant="italic">y</mi></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">d</mi><mi class="fm-mi-length-1" mathvariant="italic">x</mi></mrow></td></tr></tbody></table></span></span></mrow><mo class="fm-mo-Luc" style="font-size: 2.05em; vertical-align: -0.128em; display: inline-block; transform: scaleX(0.5);">)</mo></mrow><span class="fm-script fm-inline" style="vertical-align: -1.03em;"><mn>1</mn></span></msub></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: -0.126em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mn>2</mn><mi class="fm-mi-length-1" mathvariant="italic">a</mi></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><msub><mi class="fm-mi-length-1" mathvariant="italic">y</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>1</mn></span></msub></td></tr></tbody></table></span></span></mrow></mrow></fmath><br/>Let angle between two curves be <fmath class="fm-inline"><mi class="fm-mi-length-1" mathvariant="italic">θ</mi></fmath>.<br/><fmath class="fm-inline"><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><msub><mi class="fm-mi-length-1" mathvariant="italic">C</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>2</mn></span></msub></mrow><mo class="fm-infix-loose">:</mo><mrow><mrow><msup><mi class="fm-mi-length-1" mathvariant="italic">x</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup><mo class="fm-infix">+</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0.126em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><msup><mi class="fm-mi-length-1" mathvariant="italic">y</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup></td></tr><tr><td class="fm-den-frac fm-inline"><mn>2</mn></td></tr></tbody></table></span></span></mrow></mrow><mo class="fm-infix-loose">=</mo><msup><mi class="fm-mi-length-1" mathvariant="italic">c</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup></mrow></mrow></fmath><br/><fmath class="fm-inline"><mrow><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mo class="fm-infix-loose">⇒</mo><mrow><mrow><mn>2</mn><mi class="fm-mi-length-1" mathvariant="italic">x</mi></mrow><mo class="fm-infix">+</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mn>2</mn><mi class="fm-mi-length-1" mathvariant="italic">y</mi></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><mn>2</mn></td></tr></tbody></table></span></span><msub><mrow><mo class="fm-mo-Luc" style="font-size: 2.05em; vertical-align: -0.128em; display: inline-block; transform: scaleX(0.5);">(</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">d</mi><mi class="fm-mi-length-1" mathvariant="italic">y</mi></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">d</mi><mi class="fm-mi-length-1" mathvariant="italic">x</mi></mrow></td></tr></tbody></table></span></span></mrow><mo class="fm-mo-Luc" style="font-size: 2.05em; vertical-align: -0.128em; display: inline-block; transform: scaleX(0.5);">)</mo></mrow><span class="fm-script fm-inline" style="vertical-align: -1.03em;"><mn>2</mn></span></msub></mrow></mrow></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mn>0</mn><mo class="fm-infix-loose">⇒</mo><msub><mrow><mo class="fm-mo-Luc" style="font-size: 2.05em; vertical-align: -0.128em; display: inline-block; transform: scaleX(0.5);">(</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">d</mi><mi class="fm-mi-length-1" mathvariant="italic">y</mi></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">d</mi><mi class="fm-mi-length-1" mathvariant="italic">x</mi></mrow></td></tr></tbody></table></span></span></mrow><mo class="fm-mo-Luc" style="font-size: 2.05em; vertical-align: -0.128em; display: inline-block; transform: scaleX(0.5);">)</mo></mrow><span class="fm-script fm-inline" style="vertical-align: -1.03em;"><mn>2</mn></span></msub></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mo class="fm-prefix-tight">−</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mn>2</mn><msub><mi class="fm-mi-length-1" mathvariant="italic">x</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>1</mn></span></msub></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><msub><mi class="fm-mi-length-1" mathvariant="italic">y</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>1</mn></span></msub></td></tr></tbody></table></span></span></mrow></mrow></mrow></fmath><br/><fmath class="fm-inline"><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mo class="fm-infix-loose">∵</mo><mrow><mrow class="ma-repel-adj"><mi class="ma-repel-adj" mathvariant="normal">tan</mi><mspace style="margin-right: 0.17em; padding-right: 0.001em; visibility: hidden;" width=".17em">‌</mspace><mi class="fm-mi-length-1" mathvariant="italic">θ</mi></mrow><mo class="fm-infix-loose">=</mo></mrow></mrow><mo class="fm-mo-Luc" style="font-size: 4.15em; vertical-align: -0.19em; display: inline-block; transform: scaleX(0.5);">|</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><msub><mrow><mo class="fm-mo-Luc" style="font-size: 2.05em; vertical-align: -0.128em; display: inline-block; transform