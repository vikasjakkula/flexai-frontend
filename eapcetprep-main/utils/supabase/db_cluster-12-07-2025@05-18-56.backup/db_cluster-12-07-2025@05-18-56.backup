></mrow><mo class="fm-infix-loose">≡</mo><mrow><mo class="fm-mo-Luc">(</mo><mrow><mrow><msub><mi class="fm-mi-length-1" mathvariant="italic">x</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>1</mn></span></msub><mo class="fm-separator">,</mo><msub><mi class="fm-mi-length-1" mathvariant="italic">y</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>1</mn></span></msub></mrow><mo class="fm-separator">,</mo><msub><mi class="fm-mi-length-1" mathvariant="italic">z</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>1</mn></span></msub></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></fmath> .<br/>Equation of plane<br/> <fmath class="fm-inline"><mrow><mrow><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic">a</mi><mrow><mo class="fm-mo-Luc">(</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">x</mi><mo class="fm-infix">−</mo><msub><mi class="fm-mi-length-1" mathvariant="italic">x</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>1</mn></span></msub></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow><mo class="fm-infix">+</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">b</mi><mrow><mo class="fm-mo-Luc">(</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">y</mi><mo class="fm-infix">−</mo><msub><mi class="fm-mi-length-1" mathvariant="italic">y</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>1</mn></span></msub></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow><mo class="fm-infix">+</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">c</mi><mrow><mo class="fm-mo-Luc">(</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">z</mi><mo class="fm-infix">−</mo><msub><mi class="fm-mi-length-1" mathvariant="italic">z</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>1</mn></span></msub></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow><mo class="fm-infix-loose">=</mo><mn>0</mn></mrow></fmat