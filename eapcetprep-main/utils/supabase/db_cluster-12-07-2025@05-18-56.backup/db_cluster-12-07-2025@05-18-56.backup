)</mo></mrow></mrow></mrow><mo class="fm-infix-loose">=</mo><mn>0</mn></mrow></fmath><br/><fmath class="fm-inline"><mrow><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mi class="fm-mi-length-1" mathvariant="italic">α</mi></mrow><mo class="fm-infix-loose">=</mo><mn>6</mn></mrow><mo class="fm-separator">,</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">α</mi><mo class="fm-infix-loose">=</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mn>2</mn></td></tr><tr><td class="fm-den-frac fm-inline"><mn>3</mn></td></tr></tbody></table></span></span></mrow></mrow></mrow></fmath><br/>For <fmath class="fm-inline"><mrow><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mi class="fm-mi-length-1" mathvariant="italic">α</mi></mrow><mo class="fm-infix-loose">=</mo><mn>6</mn></mrow><mo class="fm-separator">,</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">γ</mi><mo class="fm-infix-loose">=</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mn>2</mn></td></tr><tr><td class="fm-den-frac fm-inline"><mn>3</mn></td></tr></tbody></table></span></span></mrow></mrow></mrow></fmath><br/>and for <fmath class="fm-inline"><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic">α</mi><mo class="fm-infix-loose">=</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagna