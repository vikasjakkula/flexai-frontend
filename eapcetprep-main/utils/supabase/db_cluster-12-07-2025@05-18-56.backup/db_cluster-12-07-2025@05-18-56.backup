-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0.126em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><msub><mi class="fm-mi-length-1" mathvariant="italic">µ</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>0</mn></span></msub></td></tr><tr><td class="fm-den-frac fm-inline"><mrow><mn>4</mn><mi class="fm-mi-length-1" mathvariant="italic">π</mi></mrow></td></tr></tbody></table></span></span></mrow><mo class="fm-infix-loose">=</mo><mrow><msup><mn>10</mn><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mrow><mo class="fm-prefix-tight">−</mo><mn>7</mn></mrow></span></msup><msup><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">T</mi><mi class="fm-mi-length-1" mathvariant="italic">m</mi></mrow><mi class="fm-mi-length-1" mathvariant="italic">A</mi></mrow><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mrow><mo class="fm-prefix-tight">−</mo><mn>1</mn></mrow></span></msup></mrow></mrow><mo class="fm-mo-Luc" style="font-size: 2.26em; vertical-align: -0.084em; display: inline-block; transform: scaleX(0.5);">]</mo></mrow></fmath><div class="hscrollenable"><img src="static/media/wl_client/1/qdump/dd962b43da3e663bef2c213d7dbe3f88/6295345cba21cfbdf42f24bcb96671e8.png"/></div></span>	<span><fmath class="fm-inline"><mrow><mrow><mn>33.6</mn><mi class="fm-mi-length-1" mathvariant="italic">µ</mi></mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">T</mi></mrow></fmath></span>	<span><fmath class="fm-inline"><mrow><mrow><mn>38.4</mn><mi class="fm-mi-length-1" mathvariant="italic">µ</mi></mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">T</mi></mrow></fmath> </span>	<span><fmath class="fm-inline"><mrow><mrow><mn>48.7</mn><mi class="fm-mi-length-1" mathvariant="italic">µ</mi></mrow><mi class="fm-mi-length