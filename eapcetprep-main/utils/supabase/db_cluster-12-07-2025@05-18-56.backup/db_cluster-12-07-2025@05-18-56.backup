-separator">,</mo><mrow><mrow class="ma-repel-adj"><mi class="ma-repel-adj" mathvariant="normal">ln</mi><mspace style="margin-right: 0.17em; padding-right: 0.001em; visibility: hidden;" width=".17em">‌</mspace><mn>3</mn></mrow><mo class="fm-infix-loose">=</mo><mn>1.1</mn></mrow></mrow><mo class="fm-separator">,</mo><mrow><mrow class="ma-repel-adj"><mi class="ma-repel-adj" mathvariant="normal">ln</mi><mspace style="margin-right: 0.17em; padding-right: 0.001em; visibility: hidden;" width=".17em">‌</mspace><mn>6</mn></mrow><mo class="fm-infix-loose">=</mo><mn>1.8</mn></mrow></mrow><mo class="fm-mo-Luc fm-postfix">]</mo></mrow></fmath></span>	<span><fmath class="fm-inline"><mrow class="ma-repel-adj"><mn>30</mn><mspace style="margin-right: 0.17em; padding-right: 0.001em; visibility: hidden;" width=".17em">‌</mspace><mi class="ma-repel-adj" mathvariant="normal">min</mi></mrow></fmath> </span>	<span><fmath class="fm-inline"><mrow><mn>8.5</mn><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic">m</mi><mi class="fm-mi-length-1" mathvariant="italic">i</mi></mrow><mi class="fm-mi-length-1" mathvariant="italic">n</mi></mrow></mrow></fmath></span>	<span><fmath class="fm-inline"><mrow><mn>22.4</mn><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic">m</mi><mi class="fm-mi-length-1" mathvariant="italic">i</mi></mrow><mi class="fm-mi-length-1" mathvariant="italic">n</mi></mrow></mrow></fmath> </span>	<span><fmath class="fm-inline"><mrow><mn>16.3</mn><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic">m</mi><mi class="fm-mi-length-1" mathvariant="italic">i</mi></mrow><mi class="fm-mi-length-1" mathvariant="italic">n</mi></mrow></mrow></fmath></span>	\N	\N	d	<style>.fm-math,fmath{font-family:STIXGeneral,'DejaVu Serif','DejaVu Sans',Times,OpenSymbol,'Standard Symbols L',serif;line-height:1.2}.fm-math mtext,fmath mtext{line-height:normal}.fm-mo,.ma-sans-serif,fmath mi[mathvariant*=sans-serif],fmath mn[mathvariant*=sans-serif],fmath mo,fmath ms[mathvariant*=sans-se