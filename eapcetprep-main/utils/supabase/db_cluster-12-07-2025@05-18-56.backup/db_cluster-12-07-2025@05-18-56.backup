th class="fm-inline"><mrow><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">f</mi><mrow><mo class="fm-mo-Luc">(</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">α</mi><mo class="fm-infix">−</mo><mi class="fm-mi-length-1" mathvariant="italic">δ</mi></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow><mo class="fm-infix">−</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">f</mi><mrow><mo class="fm-mo-Luc">(</mo><mi class="fm-mi-length-1" mathvariant="italic">α</mi><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow><mo class="fm-infix-loose">&gt;</mo><mn>0</mn></mrow></fmath> and <fmath class="fm-inline"><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">f</mi><mrow><mo class="fm-mo-Luc">(</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">α</mi><mo class="fm-infix">+</mo><mi class="fm-mi-length-1" mathvariant="italic">δ</mi></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow><mo class="fm-infix-loose">&lt;</mo><mn>0</mn></mrow></fmath> <br/>i.e. No maxima and minima at <fmath class="fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic">α</mi><mo class="fm-separator">,</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">α</mi><mo class="fm-infix-loose">∈</mo><mrow><mo class="fm-mo-Luc">(</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">a</mi><mo class="fm-separator">,</mo><mi class="fm-mi-length-1" mathvariant="italic">b</mi></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow></fmath></div>
