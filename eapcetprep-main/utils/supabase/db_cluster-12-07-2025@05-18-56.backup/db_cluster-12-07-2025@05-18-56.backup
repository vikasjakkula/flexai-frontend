lass="fm-mi-length-1" mathvariant="italic">L</mi></mrow><msup><mi class="fm-mi-length-1" mathvariant="italic">e</mi><span class="fm-script fm-inline" style="vertical-align: 0.95em;"><mrow><mrow><mo class="fm-prefix-tight">−</mo><mi class="fm-mi-length-1" mathvariant="italic">L</mi></mrow><mo class="fm-infix-loose">∕</mo><msub><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">E</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>0</mn></span></msub></mrow></span></msup></mrow></mrow></fmath><br/>D) <fmath class="fm-inline"><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">E</mi></mrow><mo class="fm-infix-loose">=</mo><mrow><mrow><mn>2</mn><mrow><mo class="fm-mo-Luc">(</mo><mrow><msub><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">E</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>0</mn></span></msub><mo class="fm-infix-loose">∕</mo><msub><mi class="fm-mi-length-1" mathvariant="italic">L</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>0</mn></span></msub></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow><mo class="fm-infix" lspace=".22em" rspace=".22em">×</mo><msup><mi class="fm-mi-length-1" mathvariant="italic">e</mi><span class="fm-script fm-inline" style="vertical-align: 0.95em;"><mrow><mrow><mo class="fm-prefix-tight">−</mo><mi class="fm-mi-length-1" mathvariant="italic">L</mi></mrow><mo class="fm-infix-loose">∕</mo><msub><mi class="fm-mi-length-1" mathvariant="italic">L</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>0</mn></span></msub></mrow></span></msup></mrow></mrow></fmath></span>	<span>A, B only</span>	<span>A, C only</span>	<span>A, C, D only</span>	<