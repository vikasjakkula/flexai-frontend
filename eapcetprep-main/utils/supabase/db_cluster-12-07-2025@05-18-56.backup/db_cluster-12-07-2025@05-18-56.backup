ght">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-infix">⋅</mo><mrow><mo class="fm-mo-Luc">(</mo><mi class="fm-mi-length-1" mathvariant="italic">i</mi><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow></mrow></fmath> <br/>Also, centre lies on line <fmath class="fm-inline"><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic">x</mi><mo class="fm-infix">−</mo><mi class="fm-mi-length-1" mathvariant="italic">y</mi></mrow><mo class="fm-infix-loose">=</mo><mrow><mo class="fm-prefix-tight">−</mo><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mn>3</mn><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-infix">⋅</mo><mrow><mo class="fm-mo-Luc">(</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">i</mi><mi class="fm-mi-length-1" mathvariant="italic">i</mi></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow></mrow></fmath><br/>Point of intersection of Eqs. (i) and (ii) is the centre of circle<br/>Centre, <fmath class="fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic">O</mi><mrow><mo class="fm-mo-Luc">(</mo><mrow><mn>1</mn><mo class="fm-separator">,</mo><mn>4</mn></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mrow><mrow><mrow><mspace style="margin-ri