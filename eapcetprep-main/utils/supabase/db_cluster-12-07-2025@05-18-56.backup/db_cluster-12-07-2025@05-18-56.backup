ic">t</mi><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow class="ma-repel-adj"><mn>2</mn><mspace style="margin-right: 0.17em; padding-right: 0.001em; visibility: hidden;" width=".17em">‌</mspace><mi class="ma-repel-adj" mathvariant="normal">ms</mi></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mn>2</mn><mo class="fm-infix" lspace=".22em" rspace=".22em">×</mo><mrow><msup><mn>10</mn><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mrow><mo class="fm-prefix-tight">−</mo><mn>3</mn></mrow></span></msup><mrow><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;"> </mi><mi class="fm-mi-length-1" mathvariant="italic">s</mi></mrow></mrow></mrow></mrow></fmath><br/>Initial speed, <fmath class="fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic">u</mi><mo class="fm-infix-loose">=</mo><mrow><mrow><mn>10</mn><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">m</mi></mrow><mo class="fm-infix-loose">∕</mo><mrow><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;"> </mi><mi class="fm-mi-length-1" mathvariant="italic">s</mi></mrow></mrow></mrow></fmath><br/>Let final speed be <fmath class="fm-inline"><mi class="fm-mi-length-1" mathvariant="italic">v</mi></fmath> .<br/>We know that, area under force-time graph gives impulse or change in momentum.<br/> <fmath class="fm-inline"><mo>∴</mo></fmath> Area of the triangle <fmath class="fm-inline"><mrow><mrow><mo>=</mo><mo class="fm-mo-Luc fm-infix-loose">|</mo><mrow><mo class="fm-prefix-tight">∆</mo><mi class="fm-mi-length-1" mathvariant="italic">p</mi></mrow></mrow><mo class="fm-mo-Luc fm-postfix-tight">|</mo></mrow></fmath><br/>(where, <fmath class="fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic">p</mi><mo class="fm-infix-loose">=</mo></mrow></fmath> momentum)<br/> <fmath class="fm-inline"><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mn>1</mn></td></tr><tr><td class="fm-den-frac fm-inline"><mn>2</mn></td></tr></tbody></table></span></span></mrow><mo class="fm-postfix-tight" lspace=".22em" rspace=".22em">×</mo></mrow></mrow></fmath> Base <fmath class="fm-inline"><mo lspace=".22em" rspace=".22em">×</mo></fmath> Height <fmath class="fm-inline"><mrow><mo>=</mo><mo class="fm-mo-Luc" style="font-size: 2.05em; vertical-align: -0.128em; display: inline-block; transform: scaleX(0.5);">|</mo><mrow><msub><mi class="fm-mi-length-1" mathvariant="italic">p</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">f</mi></span></msub><mo class="fm-infix">−</mo><mrow><msub><mi class="fm-mi-length-1" mathvariant="italic">p</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mi class="fm-mi-length-1" mathvariant="italic">i</mi></span></msub><mrow><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mspace style="margin-right: 0px; padding-right: 0.001em; visibility: hidden;">‌</mspace></td></tr><tr><td class="fm-den-frac fm-inline"><mspace style="margin-right: 0px; padding-right: 0.001em; visibility: hidden;">‌</mspace></td></tr></tbody></table></span></span><mo class="fm-mo-Luc" style="font-size: 2.05em; vertical-align: -0.128em; display: inline-block; transform: scaleX(0.5);">|</mo></mrow></mrow></mrow></mrow></fmath> <br/> (where, <fmath class="fm-inline"><msub><mi class="fm-mi-length-1" mathvariant="italic">p</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">f</mi></span></msub></fmath>= final momentum and <fmath class="fm-inline"><mrow><msub><mi class="fm-mi-length-1" mathvariant="italic">p</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mi class="fm-mi-length-1" mathvariant="italic">i</mi></span></msub><mo class="fm-infix-loose">=</mo></mrow></fmath> initial momentum)<br/> <fmath class="fm-inline"><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mn>1</mn></td></tr><tr><td class="fm-den-frac fm-inline"><mn>2</mn></td></tr></tbody></table></span></span></mrow><mo class="fm-infix" lspace=".22em" rspace=".22em">×</mo><mrow><mo class="fm-mo-Luc">(</mo><mrow><mn>2</mn><mo class="fm-infix" lspace=".22em" rspace=".22em">×</mo><msup><mn>10</mn><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mrow><mo class="fm-prefix-tight">−</mo><mn>3</mn></mrow></span></msup></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow><mo class="fm-infix" lspace=".22em" rspace=".22em">×</mo><mrow><mo class="fm-mo-Luc">(</mo><mrow><mn>20</mn><mo class="fm-infix" lspace=".22em" rspace=".22em">×</mo><mn>1000</mn></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mrow><mn>0.1</mn><mi class="fm-mi-length-1" mathvariant="italic">v</mi></mrow><mo class="fm-infix">−</mo><mrow><mn>0.1</mn><mi class="fm-mi-length-1" mathvariant="italic">u</mi></mrow></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mo class="fm-mo-Luc">(</mo><mrow><mo class="fm-prefix-tight">∵</mo><mrow><mrow class="ma-repel-adj"><mn>20</mn><mspace style="margin-right: 0.17em; padding-right: 0.001em; visibility: hidden;" width=".17em">‌</mspace><mi class="ma-repel-adj" mathvariant="normal">kN</mi></mrow><mo class="fm-infix-loose">=</mo><mrow><mn>20000</mn><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">N</mi></mrow></mrow></mrow><mo class="fm-mo-Luc">)</mo></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mn>2</mn></mrow><mo class="fm-infix" lspace=".22em" rspace=".22em">×</mo><mn>10</mn></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mrow><mrow><mrow><mn>0</mn><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">l</mi></mrow><mrow><mo class="fm-mo-Luc">(</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">v</mi><mo class="fm-infix">−</mo><mn>10</mn></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow><mo class="fm-mo-Luc">(</mo><mrow><mo class="fm-prefix-tight">∵</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">u</mi><mo class="fm-infix-loose">=</mo><mrow><mrow><mn>10</mn><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">m</mi></mrow><mo class="fm-infix-loose">∕</mo><mrow><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;"> </mi><mi class="fm-mi-length-1" mathvariant="italic">s</mi></mrow></mrow></mrow></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidde