lass="fm-infix">−</mo><mrow><mn>6</mn><mi class="fm-mi-length-1" mathvariant="italic">y</mi></mrow></mrow><mo class="fm-infix">−</mo><mn>12</mn></mrow><mo class="fm-infix-loose">=</mo><mn>0</mn></mrow></mrow></fmath><br/>With centre <fmath class="fm-inline"><mrow><mrow><msub><mi class="fm-mi-length-1" mathvariant="italic">C</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>2</mn></span></msub><mo class="fm-infix-loose">:</mo><mrow><mo class="fm-mo-Luc">(</mo><mrow><mrow><mo class="fm-prefix-tight">−</mo><mn>2</mn></mrow><mo class="fm-separator">,</mo><mn>3</mn></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow><mo class="fm-separator">,</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">r</mi><mo class="fm-infix-loose">=</mo><mn>5</mn></mrow></mrow></fmath><br/>Tangent at <fmath class="fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">M</mi><mrow><mo class="fm-mo-Luc">(</mo><mrow><mn>1</mn><mo class="fm-separator">,</mo><mrow><mo class="fm-prefix-tight">−</mo><mn>1</mn></mrow></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></fmath> to the circle <fmath class="fm-inline"><mi class="fm-mi-length-1" mathvariant="italic">C</mi></fmath> is <br/> <fmath class="fm-inline"><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow><mi class="fm-mi-length-1" mathvariant="italic">x</mi><msub><mi class="fm-mi-length-1" mathvariant="italic">x</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>1</mn></span></msub></mrow></mrow><mo class="fm-infix">+</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">y</mi><msub><mi class="fm-mi-length-1" mathvariant="italic">y</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>1</mn></span></msub></mrow></mrow><mo class="fm-infix">+</mo><mrow><mn>4</mn><mrow><mo class="fm-mo-Luc" style="font-size: 2.26em; vertical-align: -0.084em; display: inline-block; transform: scaleX(0.5);">(</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0.126em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic">x</mi><mo class="fm-infix">+</mo><msub><mi class="fm-mi-length-1" mathvariant="italic">x</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>1</mn></span></msub></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><mn>2</mn></td></tr></tbody></table></span></span></mrow><mo class="fm-mo-Luc" style="font-size: 2.26em; vertical-align: -0.084em; display: inline-block; transform: scaleX(0.5);">)</mo></mrow></mrow></mrow><mo class="fm-infix">−</mo><mrow><mn>6</mn><mrow><mo class="fm-mo-Luc" style="font-size: 2.26em; vertical-align: -0.084em; display: inline-block; transform: scaleX(0.5);">(</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0.126em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic">y</mi><mo class="fm-infix">+</mo><msub><mi class="fm-mi-length-1" mathvariant="italic">y</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>1</mn></span></msub></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><mn>2</mn></td></tr></tbody></table></span></span></mrow><mo class="fm-mo-Luc" style="font-size: 2.26em; vertical-align: -0.084em; display: inline-block; transform: scaleX(0.5);">)</mo></mrow></mrow></mrow><mo class="fm-infix">−</mo><mn>12</mn></mrow><mo class="fm-infix-loose">=</mo><mn>0</mn></mrow></fmath><br/><fmath class="fm-inline"><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mi class="fm-mi-length-1" mathvariant="italic">x</mi></mrow><mo class="fm-infix">−</mo><mi class="fm-mi-length-1" mathvariant="italic">y</mi></mrow><mo class="fm-infix">+</mo><mrow><mn>2</mn><mrow><mo class="fm-mo-Luc">(</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">x</mi><mo class="fm-infix">+</mo><mn>1</mn></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow><mo class="fm-infix">−</mo><mrow><mn>3</mn><mrow><mo class="fm-mo-Luc">(</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">y</mi><mo class="fm-infix">−</mo><mn>1</mn></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow><mo class="fm-infix">−</mo><mn>12</mn></mrow><mo class="fm-infix-loose">=</mo><mn>0</mn></mrow></fmath><br/><fmath class="fm-inline"><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mo class="fm-infix-loose">⇒</mo><mrow><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow><mn>3</mn><mi class="fm-mi-length-1" mathvariant="italic">x</mi></mrow></mrow><mo class="fm-infix">−</mo><mrow><mn>4</mn><mi class="fm-mi-length-1" mathvariant="italic">y</mi></mrow></mrow><mo class="fm-infix">−</mo><mn>7</mn></mrow></mrow><mo class="fm-infix-loose">=</mo><mn>0</mn></mrow></fmath><br/><fmath class="fm-inline"><mrow><mrow><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mtext> So, equation of circle </mtext></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mi class="fm-mi-length-1" mathvariant="italic">C</mi></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mtext> touching the line </mtext></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow></fmath><br/><fmath class="fm-inline"><mrow><mrow><mrow><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow><mn>3</mn><mi class="fm-mi-length-1" mathvariant="italic">x</mi></mrow></mrow><mo class="fm-infix">−</mo><mrow><mn>4</mn><mi class="fm-mi-length-1" mathvariant="italic">y</mi></mrow></mrow><mo class="fm-infix">−</mo><mn>7</mn></mrow><mo class="fm-infix-loose">=</mo><mrow><mrow><mn>0</mn><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mtext> at </mtext></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow><mo class="fm-mo-Luc">(</mo><mrow><mn>1</mn><mo class="fm-separator">,</mo><mrow><mo class="fm-prefix-tight">−</mo><mn>1</mn></mrow></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow></fmath><br/><fmath class="fm-inline"><mrow><mrow><mrow><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width="