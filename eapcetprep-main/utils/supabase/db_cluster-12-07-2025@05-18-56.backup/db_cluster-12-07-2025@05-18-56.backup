--
-- Name: orders Affiliates can view orders they referred; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Affiliates can view orders they referred" ON public.orders FOR SELECT USING ((EXISTS ( SELECT 1
   FROM public.affiliates
  WHERE ((affiliates.id = orders.affiliate_id) AND (affiliates.user_id = auth.uid())))));


--
-- Name: user_analytics Service role can manage all analytics; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Service role can manage all analytics" ON public.user_analytics USING (((auth.jwt() ->> 'role'::text) = 'service_role'::text));


--
-- Name: user_analytics Users can read their own analytics; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can read their own analytics" ON public.user_analytics FOR SELECT USING ((auth.uid() = user_id));


--
-- Name: user_analytics Users can update their own analytics; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can update their own analytics" ON public.user_analytics FOR UPDATE USING ((auth.uid() = user_id));


--
-- Name: orders Users can view their own orders; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can view their own orders" ON public.orders FOR SELECT USING ((auth.uid() = user_id));


