v><div style="position: relative;z-index:1"> Given, <fmath class="fm-inline"><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">U</mi><mrow><mo class="fm-mo-Luc">(</mo><mi class="fm-mi-length-1" mathvariant="italic">x</mi><mo class="fm-mo-Luc">)</mo></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mrow><mo class="fm-mo-Luc">(</mo><mrow><mrow><mn>5</mn><msup><mi class="fm-mi-length-1" mathvariant="italic">x</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup></mrow><mo class="fm-infix">−</mo><mrow><mn>4</mn><msup><mi class="fm-mi-length-1" mathvariant="italic">x</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>3</mn></span></msup></mrow></mrow><mo class="fm-mo-Luc">)</mo></mrow><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">J</mi></mrow></mrow></fmath><br/>We know, <fmath class="fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">F</mi><mo class="fm-infix-loose">=</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mo class="fm-prefix-tight">−</mo><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">d</mi><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">U</mi></mrow><mrow><mo class="fm-mo-Luc">(</mo><mi class="fm-mi-length-1" mathvariant="italic">x</mi><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">d</mi><mi class="fm-mi-length-1" mathvariant="italic">x</mi></mrow></td></tr></tbody></table></span></span></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">F</mi></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mo class="fm-prefix-tight">−</mo><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">d</mi></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">d</mi><mi class="fm-mi-length-1" mathvariant="italic">x</mi></mrow></td></tr></tbody></table></span></span><mrow><mo class="fm-mo-Luc">(</mo><mrow><mrow><mn>5</mn><msup><mi class="fm-mi-length-1" mathvariant="italic">x</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup></mrow><mo class="fm-infix">−</mo><mrow><mn>4</mn><msup><mi class="fm-mi-length-1" mathvariant="italic">x</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>3</mn></span></msup></mrow></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mrow><mo class="fm-prefix-tight">−</mo><mrow><mn>10</mn><mi class="fm-mi-length-1" mathvariant="italic">x</mi></mrow></mrow><mo class="fm-infix">+</mo><mrow><mn>12</mn><msup><mi class="fm-mi-length-1" mathvariant="italic">x</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup></mrow></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">F</mi><mo class="fm-infix-loose">=</mo><mn>0</mn></mrow></fmath> (given) <br/> <fmath class="fm-inline"><mrow><mo class="fm-prefix-tight">∴</mo><mrow><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow><mn>12</mn><msup><mi class="fm-mi-length-1" mathvariant="italic">x</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mn>2</mn></span></msup></mrow></mrow><mo class="fm-infix">−</mo><mrow><mn>10</mn><mi class="fm-mi-length-1" mathvariant="italic">x</mi></mrow></mrow><mo class="fm-infix-loose">=</mo><mn>0</mn></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow><mrow><mn>2</mn><mi class="fm-mi-length-1" mathvariant="italic">x</mi></mrow><mrow><mo class="fm-mo-Luc">(</mo><mrow><mrow><mn>6</mn><mi class="fm-mi-length-1" mathvariant="italic">x</mi></mrow><mo class="fm-infix">−</mo><mn>5</mn></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow></mrow><mo class="fm-infix-loose">=</mo><mn>0</mn></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mo class="fm-prefix-tight">∴</mo><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow><mn>2</mn><mi class="fm-mi-length-1" mathvariant="italic">x</mi></mrow></mrow><mo class="fm-infix-loose">=</mo><mn>0</mn></mrow></mrow></fmath> or <fmath class="fm-inline"><mrow><mrow><mrow><mn>6</mn><mi class="fm-mi-length-1" mathvariant="italic">x</mi></mrow><mo class="fm-infix">−</mo><mn>5</mn></mrow><mo class="fm-infix-loose">=</mo><mn>0</mn></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mi class="fm-mi-length-1" mathvariant="italic">x</mi></mrow></mrow><mo class="fm-infix-loose">=</mo><mn>0</mn></mrow></fmath> or <fmath class="fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic">x</mi><mo class="fm-infix-loose">=</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mn>5</mn></td></tr><tr><td class="fm-den-frac fm-inline"><mn>6</mn></td></tr></tbody></table></span></span><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">m</mi></mrow></mrow></mrow></fmath><br/></div>
