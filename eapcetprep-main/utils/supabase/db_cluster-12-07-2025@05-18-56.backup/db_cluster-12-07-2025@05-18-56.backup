i class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">d</mi><mi class="fm-mi-length-1" mathvariant="italic">t</mi></mrow></td></tr></tbody></table></span></span></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mo>⇒</mo><mo class="fm-mo-Luc fm-infix-loose">|</mo><mi class="fm-mi-length-1" mathvariant="italic">e</mi></mrow><mo class="fm-mo-Luc" style="font-size: 2.05em; vertical-align: -0.128em; display: inline-block; transform: scaleX(0.5);">|</mo><mrow><mrow><mo class="fm-infix-loose">=</mo><mrow><mrow><mrow><mrow><msub><mi class="fm-mi-length-1" mathvariant="italic">µ</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>0</mn></span></msub><mi class="fm-mi-length-1" mathvariant="italic">n</mi></mrow><mi class="fm-mi-length-1" mathvariant="italic">A</mi></mrow><mo class="fm-postfix-tight">.</mo></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mo class="fm-prefix-tight">∆</mo><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">I</mi></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><mrow><mo class="fm-prefix-tight">∆</mo><mi class="fm-mi-length-1" mathvariant="italic">t</mi></mrow></td></tr></tbody></table></span></span></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mn>4</mn><mi class="fm-mi-length-1" mathvariant="italic">π</mi></mrow><mo class="fm-infix" lspace=".22em" rspace=".22em">×</mo><msup><mn>10</mn><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mrow><mo class="fm-prefix-tight">−</mo><mn>7</mn></mrow></span></msup></mrow><mo class="fm-infix" lspace=".22em" rspace=".22em">×</mo><mn>2000</mn></mrow><mo class="fm-postfix-tight" lspace=".22em" rspace=".22em">×</mo></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mn>4</mn></td></tr><tr><td class="fm-den-frac fm-inline"><mi class="fm-mi-length-1" mathvariant="italic">π</mi></td></tr></tbody></table></span></span></mrow><mo class="fm-infix" lspace=".22em" rspace=".22em">×</mo><msup><mn>10</mn><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mrow><mo class="fm-prefix-tight">−</mo><mn>4</mn></mrow></span></msup></mrow><mo class="fm-postfix-tight" lspace=".22em" rspace=".22em">×</mo></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mn>2</mn></td></tr><tr><td class="fm-den-frac fm-inline"><mn>0.2</mn></td></tr></tbody></table></span></span></mrow></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mo class="fm-infix-loose">=</mo><mrow><mn>3.2</mn><mo class="fm-infix" lspace=".22em" rspace=".22em">×</mo><mrow><msup><mn>10</mn><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mrow><mo class="fm-prefix-tight">−</mo><mn>6</mn></mrow></span></msup><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">V</mi></mrow></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mo class="fm-infix-loose">=</mo><mrow><mrow><mn>3.2</mn><mi class="fm-mi-length-1" mathvariant="italic">µ</mi></mrow><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">V</mi></mrow></mrow></fmath> <fmath class="fm-inline"><mrow><mo class="fm-mo-Luc">(</mo><mrow><mo class="fm-prefix-tight">∵</mo><mrow><mrow><msup><mn>10</mn><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mrow><mo class="fm-prefix-tight">−</mo><mn>6</mn></mrow></span></msup><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">V</mi></mrow><mo class="fm-infix-loose">=</mo><mrow><mrow><mn>1</mn><mi class="fm-mi-length-1" mathvariant="italic">µ</mi></mrow><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">V</mi></mrow></mrow></mrow><mo class="fm-mo-Luc">)</mo></mrow></fmath><br/></div>
