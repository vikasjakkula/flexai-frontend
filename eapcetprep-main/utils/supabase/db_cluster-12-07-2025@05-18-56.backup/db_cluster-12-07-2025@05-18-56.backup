-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-infix">⋅</mo><mrow><mo class="fm-mo-Luc">(</mo><mi class="fm-mi-length-1" mathvariant="italic">i</mi><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow></fmath><br/>wherè, <fmath class="fm-inline"><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mo class="fm-prefix-tight">−</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">d</mi><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">T</mi></mrow></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">d</mi><mi class="fm-mi-length-1" mathvariant="italic">t</mi></mrow></td></tr></tbody></table></span></span></mrow><mo class="fm-infix-loose">=</mo></mrow></fmath> Cooling rate,<br/> <fmath class="fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">T</mi><mo class="fm-infix-loose">=</mo></mrow></fmath> Body's temperature,<br/> <fmath class="fm-inline"><mrow><msub><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">T</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>0</mn></span></msub><mo class="fm-infix-loose">=</mo></mrow></fmath> Surrounding temperature and <fmath class="fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic">b</mi><mo class="fm-infix-loose">=</mo></mrow></fmath> Constant.<br/> <fmath class="fm-inline"><mo>∴</mo></fmath> From Eq. (i),<br/> <fmath class="fm-inline"><mrow><mrow class="ma-repel-adj"><msup class="fm-prefix"><span mtagname="munder" style="vertical-align: -0.601em;"><span class="fm-vert"><table><tbody><tr><td class="fm-underover-base"><mo class="fm-large-op">∫</mo></td></tr><tr><td class="fm-script fm-inline"><span mtagname="mover" style="vertical-align: 0.426em;"><span class="fm-vert"><table><tbody><tr><td class="fm-script fm-inline"><mi class="fm-mi-length-1" mathvariant="italic">i</mi></td></tr><tr><td class="fm-underover-base"><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">T</mi></td></tr></tbody></table></span></span></td></tr></tbody></table></span></span><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">T</mi></span></msup><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: -0.126em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">d</mi><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">T</mi></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">T</mi><mo class="fm-infix">−</mo><msub><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">T</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>0</mn></span></msub></mrow></td></tr></tbody></table></span></span></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mo class="fm-prefix-tight">−</mo><mrow class="ma-repel-adj"><mi class="fm-mi-length-1" mathvariant="italic">b</mi><mspace style="margin-right: 0.17em; padding-right: 0.001em; visibility: hidden;" width=".17em">‌</mspace><mrow class="ma-repel-adj"><span class="fm-prefix" mtagname="munderover" style="vertical-align: 0.064em;"><span class="fm-vert"><table><tbody><tr><td class="fm-script fm-inline"><mi class="fm-mi-length-1" mathvariant="italic">t</mi></td></tr><tr><td class="fm-underover-base"><mo class="fm-large-op">∫</mo></td></tr><tr><td class="fm-script fm-inline"><mn>0</mn></td></tr></tbody></table></span></span><mi class="ma-repel-adj" mathvariant="normal">dt</mi></mrow></mrow></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">T</mi></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><msub><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">T</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>0</mn></span></msub><mo class="fm-infix">+</mo><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mo class="fm-mo-Luc">(</mo><mrow><msub><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">T</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mi class="fm-mi-length-1" mathvariant="italic">i</mi></span></msub><mo class="fm-infix">−</mo><msub><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">T</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>0</mn></span></msub></mrow><mo class="fm-mo-Luc">)</mo></mrow><msup><mi class="fm-mi-length-1" mathvariant="italic">e</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mrow><mo class="fm-prefix-tight">−</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">b</mi><mi class="fm-mi-length-1" mathvariant="italic">t</mi></mrow></mrow></span></msup></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-postfix-tight">⋅</mo></mrow><mo class="fm-infix">⋅</mo><mrow><mo class="fm-mo-Luc">(</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">i</mi><mi class="fm-mi-length-1" mathvariant="italic">i</mi></mrow><mo class="fm-mo-Luc">)</mo></mrow></mrow></mrow></mrow></fmath><br/>From the first condition of question,<br/> <fmath class="fm-inline"><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">T</mi><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mo class="fm-infix-loose">=</mo><mrow><msup><mn>40</mn><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mo>∘</mo></span></msup><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">C</mi></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><msub><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">T</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mn>0</mn></span></msub><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mo class="fm-infix-loose">=</mo><mrow><msup><mn>10</mn><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mo>∘</mo></span></msup><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">C</mi></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><msub><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">T</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mi class="fm-mi-length-1" mathvariant="italic">i</mi></span></msub><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mo class="fm-infix-loose">=</mo><mrow><msup><mn>100</mn><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mo>∘</mo></span></msup><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">C</mi></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mi class="fm-mi-length-1" mathvariant="italic">t</mi><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mo class="fm-infix-loose">=</mo><mrow class="ma-repel-adj"><mn>10</mn><mspace style="margin-right: 0.17em; padding-right: 0.001em; visibility: hidden;" width=".17em">‌</mspace><mi class="ma-repel-adj" mathvariant="normal">min</mi></mrow></mrow></fmath><br/>Putting these value in Eq. (ii),<br/> <fmath class="fm-inline"><mrow><mn>40</mn><mo class="fm-infix-loose">=</mo><mrow><mn>10</mn><mo class="fm-infix">+</mo><mrow><mrow><mo class="fm-mo-Luc">(</mo><mrow><mn>100</mn><mo class="fm-infix">−</mo><mn>10</mn></mrow><mo class="fm-mo-Luc">)</mo></mrow><msup><mi class="fm-mi-length-1" mathvariant="italic">e</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mrow><mo class="fm-prefix-tight">−</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">b</mi><mo class="fm-infix" lspace=".22em" rspace=".22em">×</mo><mn>10</mn></mrow></mrow></span></msup></mrow></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mn>30</mn></td></tr><tr><td class="fm-den-frac fm-inline"><mn>90</mn></td></tr></tbody></table></span></span></mrow></mrow><mo class="fm-infix-loose">=</mo><msup><mi class="fm-mi-length-1" mathvariant="italic">e</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mrow><mo class="fm-prefix-tight">−</mo><mrow><mn>10</mn><mi class="fm-mi-length-1" mathvariant="italic">b</mi></mrow></mrow></span></msup></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mn>1</mn></td></tr><tr><td class="fm-den-frac fm-inline"><mn>3</mn></td></tr></tbody></table></span></span></mrow></mrow><mo class="fm-infix-loose">=</mo><msup><mi class="fm-mi-length-1" mathvariant="italic">e</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mrow><mo class="fm-prefix-tight">−</mo><mrow><mn>10</mn><mi class="fm-mi-length-1" mathvariant="italic">b</mi></mrow></mrow></span></msup></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow class="ma-repel-adj"><mi class="ma-repel-adj" mathvariant="normal">ln</mi><mrow><mo class="fm-mo-Luc" style="font-size: 2.05em; vertical-align: -0.128em; display: inline-block; transform: scaleX(0.5);">(</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mn>1</mn></td></tr><tr><td class="fm-den-frac fm-inline"><mn>3</mn></td></tr></tbody></table></span></span></mrow><mo class="fm-mo-Luc" style="font-size: 2.05em; vertical-align: -0.128em; display: inline-block; transform: scaleX(0.5);">)</mo></mrow></mrow></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mo class="fm-prefix-tight">−</mo><mrow class="ma-repel-adj"><mrow class="ma-repel-adj"><mrow><mn>10</mn><mi class="fm-mi-length-1" mathvariant="italic">b</mi></mrow><mspace style="margin-right: 0.17em; padding-right: 0.001em; visibility: hidden;" width=".17em">‌</mspace><mi class="ma-repel-adj" mathvariant="normal">ln</mi></mrow><mspace style="margin-right: 0.17em; padding-right: 0.001em; visibility: hidden;" width=".17em">‌</mspace><mi class="fm-mi-length-1" mathvariant="italic">m</mi></mrow></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow class="ma-repel-adj"><mi class="ma-repel-adj" mathvariant="normal">ln</mi><mspace style="margin-right: 0.17em; padding-right: 0.001em; visibility: hidden;" width=".17em">‌</mspace><mn>1</mn></mrow></mrow><mo class="fm-infix">−</mo><mrow class="ma-repel-adj"><mi class="ma-repel-adj" mathvariant="normal">ln</mi><mspace style="margin-right: 0.17em; padding-right: 0.001em; visibility: hidden;" width=".17em">‌</mspace><mn>3</mn></mrow></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mo class="fm-prefix-tight">−</mo><mrow><mn>10</mn><mi class="fm-mi-length-1" mathvariant="italic">b</mi></mrow></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><mo class="fm-prefix-tight">−</mo><mrow><mrow class="ma-repel-adj"><mi class="ma-repel-adj" mathvariant="normal">ln</mi><mspace style="margin-right: 0.17em; padding-right: 0.001em; visibility: hidden;" width=".17em">‌</mspace><mn>3</mn></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mo class="fm-prefix-tight">−</mo><mrow><mn>10</mn><mi class="fm-mi-length-1" mathvariant="italic">b</mi></mrow></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mi class="fm-mi-length-1" mathvariant="italic">b</mi></mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow class="ma-repel-adj"><mi class="ma-repel-adj" mathvariant="normal">ln</mi><mspace style="margin-right: 0.17em; padding-right: 0.001em; visibility: hidden;" width=".17em">‌</mspace><mn>3</mn></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><mn>10</mn></td></tr></tbody></table></span></span></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mn>1.1</mn></td></tr><tr><td class="fm-den-frac fm-inline"><mn>10</mn></td></tr></tbody></table></span></span></mrow></mrow></fmath><br/>Now, by next condition of question,<br/> <fmath class="fm-inline"><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">T</mi></mrow><mo class="fm-infix-loose">=</mo><mrow><msup><mn>20</mn><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mo>∘</mo></span></msup><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">C</mi></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><msub><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">T</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mi class="fm-mi-length-1" mathvariant="italic">i</mi></span></msub></mrow><mo class="fm-infix-loose">=</mo><mrow><msup><mn>70</mn><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mo>∘</mo></span></msup><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">C</mi></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><msub><mi class="fm-mi-length-1" mathvariant="italic" style="padding-right: 0.44ex;">T</mi><span class="fm-script fm-inline" style="vertical-align: -0.5em;"><mi class="fm-mi-length-1" mathvariant="italic">a</mi></span></msub></mrow><mo class="fm-infix-loose">=</mo><mrow><msup><mn>10</mn><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mo>∘</mo></span></msup><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">C</mi></mrow></mrow></fmath><br/>From Eq. (ii),<br/> <fmath class="fm-inline"><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mn>20</mn></mrow><mo class="fm-infix-loose">=</mo><mrow><mn>10</mn><mo class="fm-infix">+</mo><mrow><mrow><mo class="fm-mo-Luc">(</mo><mrow><mn>70</mn><mo class="fm-infix">−</mo><mn>10</mn></mrow><mo class="fm-mo-Luc">)</mo></mrow><msup><mi class="fm-mi-length-1" mathvariant="italic">e</mi><span class="fm-script fm-inline" style="vertical-align: 0.7em;"><mrow><mo class="fm-prefix-tight">−</mo><mrow><mi class="fm-mi-length-1" mathvariant="italic">b</mi><mi class="fm-mi-length-1" mathvariant="italic">t</mi></mrow></mrow></span></msup></mrow></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mn>10</mn></td></tr><tr><td class="fm-den-frac fm-inline"><mn>60</mn></td></tr></tbody></table></span></span></mrow><mo class="fm-infix-loose">=</mo><msup><mi class="fm-mi-length-1" mathvariant="italic">e</mi><span class="fm-script fm-inline" style="vertical-align: 1.33em;"><mrow><mo class="fm-prefix-tight">−</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mn>1.1</mn></td></tr><tr><td class="fm-den-frac fm-inline"><mn>10</mn></td></tr></tbody></table></span></span><mi class="fm-mi-length-1" mathvariant="italic">t</mi></mrow></mrow></mrow></span></msup></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow class="ma-repel-adj"><mi class="ma-repel-adj" mathvariant="normal">ln</mi><mrow><mo class="fm-mo-Luc" style="font-size: 2.05em; vertical-align: -0.128em; display: inline-block; transform: scaleX(0.5);">(</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mn>1</mn></td></tr><tr><td class="fm-den-frac fm-inline"><mn>6</mn></td></tr></tbody></table></span></span></mrow><mo class="fm-mo-Luc" style="font-size: 2.05em; vertical-align: -0.128em; display: inline-block; transform: scaleX(0.5);">)</mo></mrow></mrow></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mo class="fm-prefix-tight">−</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow class="ma-repel-adj"><mrow class="ma-repel-adj"><mrow><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mn>11</mn></td></tr><tr><td class="fm-den-frac fm-inline"><mn>6</mn></td></tr></tbody></table></span></span><mi class="fm-mi-length-1" mathvariant="italic">t</mi></mrow><mspace style="margin-right: 0.17em; padding-right: 0.001em; visibility: hidden;" width=".17em">‌</mspace><mi class="ma-repel-adj" mathvariant="normal">ln</mi></mrow><mspace style="margin-right: 0.17em; padding-right: 0.001em; visibility: hidden;" width=".17em">‌</mspace><mi class="fm-mi-length-1" mathvariant="italic">e</mi></mrow></mrow></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow class="ma-repel-adj"><mi class="ma-repel-adj" mathvariant="normal">ln</mi><mspace style="margin-right: 0.17em; padding-right: 0.001em; visibility: hidden;" width=".17em">‌</mspace><mi class="fm-mi-length-1 ma-upright" mathvariant="normal" style="padding-right: 0px;">l</mi></mrow></mrow><mo class="fm-infix">−</mo><mrow class="ma-repel-adj"><mi class="ma-repel-adj" mathvariant="normal">ln</mi><mspace style="margin-right: 0.17em; padding-right: 0.001em; visibility: hidden;" width=".17em">‌</mspace><mn>6</mn></mrow></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mo class="fm-prefix-tight">−</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mn>1.1</mn></td></tr><tr><td class="fm-den-frac fm-inline"><mn>10</mn></td></tr></tbody></table></span></span><mi class="fm-mi-length-1" mathvariant="italic">t</mi></mrow></mrow></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace></mrow><mo class="fm-infix">−</mo><mrow class="ma-repel-adj"><mi class="ma-repel-adj" mathvariant="normal">ln</mi><mspace style="margin-right: 0.17em; padding-right: 0.001em; visibility: hidden;" width=".17em">‌</mspace><mn>6</mn></mrow></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mrow><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mo class="fm-prefix-tight">−</mo><mn>11</mn></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><mn>100</mn></td></tr></tbody></table></span></span><mi class="fm-mi-length-1" mathvariant="italic">t</mi></mrow></mrow></mrow></fmath><br/> <fmath class="fm-inline"><mrow><mrow><mrow><mrow><mo class="fm-prefix-tight">⇒</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><mi class="fm-mi-length-1" mathvariant="italic">t</mi></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mn>100</mn><mo class="fm-infix" lspace=".22em" rspace=".22em">×</mo><mrow class="ma-repel-adj"><mi class="ma-repel-adj" mathvariant="normal">ln</mi><mspace style="margin-right: 0.17em; padding-right: 0.001em; visibility: hidden;" width=".17em">‌</mspace><mn>6</mn></mrow></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><mn>11</mn></td></tr></tbody></table></span></span></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow><mspace style="margin-right: 0.28em; padding-right: 0.001em; visibility: hidden;" width=".28em">‌</mspace><span mtagname="mfrac" style="vertical-align: 0em;"><span class="fm-vert fm-frac"><table><tbody><tr><td class="fm-num-frac fm-inline"><mrow><mn>100</mn><mo class="fm-infix" lspace=".22em" rspace=".22em">×</mo><mn>1.8</mn></mrow></td></tr><tr><td class="fm-den-frac fm-inline"><mn>11</mn></td></tr></tbody></table></span></span></mrow></mrow><mo class="fm-infix-loose">=</mo><mrow class="ma-repel-adj"><mn>16.3</mn><mspace style="margin-right: 0.17em; padding-right: 0.001em; visibility: hidden;" width=".17em">‌</mspace><mi class="ma-repel-adj" mathvariant="normal">min</mi></mrow></mrow></fmath></div>
